<?xml version="1.0" encoding="UTF-8"?>

<configuration>
    <system.webServer>

        <!-- Prevent WebDAV from intercepting PUT/DELETE requests -->
        <modules>
            <!-- Remove the WebDAV module so it stops intercepting requests -->
            <remove name="WebDAVModule" />
        </modules>
        <handlers>
            <!-- Remove the WebDAV handler -->
            <remove name="WebDAV" />
            <!-- Ensure your application handler allows all verbs (*) -->
            <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
            <add name="ExtensionlessUrlHandler-Integrated-4.0" 
                path="*." 
                verb="*" type="System.Web.Handlers.TransferRequestHandler" 
                preCondition="integratedMode,runtimeVersionv4.0" />
			 <!-- Extend verbs for PHP FastCGI -->
			  <add name="PHP_via_FastCGI"
				   path="*.php"
				   verb="GET,HEAD,POST,PUT,DELETE"
				   modules="FastCgiModule"
				   scriptProcessor="D:\Program Files (x86)\Plesk\Additional\PleskPHP83\php-cgi.exe"
				   resourceType="Either"
				   requireAccess="Script" />
        </handlers>
	<httpProtocol>
      <customHeaders>
        <!--Enable Mine Sniff Protection-->
        <add name="X-Content-Type-Options" value="nosniff" />
        <!--Content-Security-Policy-->
        <!--<add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; form-action 'self'; report-uri /WebResource.axd?cspReport=true" />-->
        <!--Enable X-XSS-Protection-->
        <remove name="X-Powered-By" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <!--X-Frame-Options - Clickjaking-->
        <add name="X-Frame-Options" value="DENY" />
        <!-- Fixes: Referrer-Policy -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        
        <!-- Fixes: Permissions-Policy -->
        <!-- This example disables intrusive features like camera, microphone, and geolocation -->
        <add name="Permissions-Policy" value="accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" />

      </customHeaders>
    </httpProtocol>
        <!-- Laravel URL rewriting -->
        <rewrite>
            <rules>
                <rule name="Laravel" stopProcessing="true">
                    <match url=".*" />

                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}"
                             matchType="IsFile"
                             negate="true" />

                        <add input="{REQUEST_FILENAME}"
                             matchType="IsDirectory"
                             negate="true" />
                    </conditions>

                    <action type="Rewrite" url="index.php" />
                </rule>
            </rules>
        </rewrite>

    </system.webServer>
</configuration>